{
  "name": "ktranslationhelper",
  "version": "0.1.2",
  "description": "Let visitors flag and fix missing or incorrect translations on multi-language websites.",
  "license": "MIT",
  "main": "dist/ktranslationhelper.js",
  "module": "dist/ktranslationhelper.mjs",
  "browser": "dist/ktranslationhelper.js",
  "types": "dist/ktranslationhelper.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/ktranslationhelper.d.mts", "default": "./dist/ktranslationhelper.mjs" },
      "require": { "types": "./dist/ktranslationhelper.d.ts", "default": "./dist/ktranslationhelper.js" },
      "default": "./dist/ktranslationhelper.js"
    },
    "./locales/*": "./dist/locales/*"
  },
  "files": ["dist", "src", "README.md", "LICENSE", "CHANGELOG.md"],
  "sideEffects": false,
  "scripts": {
    "build": "node build.mjs",
    "test": "node tests/demo.test.mjs",
    "test:a11y": "node tests/a11y.test.mjs",
    "demo": "php -S localhost:8000"
  },
  "keywords": ["i18n", "translation", "l10n", "localization", "crowdsourcing", "translation-management"],
  "engines": { "node": ">=18" }
}
